# Copy to .env and fill in. Loaded automatically by the release via
# rel/env.sh.eex on every start. Plain KEY=value lines (no `export` needed).

# Required. Generate with: mix phx.gen.secret
# Keep this stable — changing it invalidates all login tokens.
SECRET_KEY_BASE=

# Required. The single login password.
LOOM_PASSWORD=

# Must be true for the release to actually serve HTTP.
PHX_SERVER=true

# Optional: the hostname Cloudflare serves. Used for generated absolute URLs
# only, of which loom has none — nothing checks it, and nothing breaks if it
# is wrong. `check_origin` and `force_ssl` are both off: the request arrives
# proxied over plain HTTP with the edge's own Host and Origin.
# PHX_HOST=loom.example.com

# Optional: listen port (defaults to 4000). Whatever the tunnel points at;
# binding 80 would need root or CAP_NET_BIND_SERVICE for nothing.
# PORT=4000

# Optional: listen address. Defaults to 127.0.0.1, which is what the
# `cloudflared`-on-the-same-host setup wants: the tunnel dials *out*, so
# nothing has to be reachable from the network and the security group needs no
# inbound rule at all. Only widen this if the tunnel runs on another machine —
# and then restrict ingress to that host, because what reaches this port gets
# an unsandboxed agent behind one password.
# LOOM_BIND=127.0.0.1

# Optional: where loom keeps its own state — session headers, transcripts, and
# the files you attach to a conversation. Defaults to ~/.loom. Deliberately
# outside the release, which a deploy replaces.
# LOOM_HOME=/home/loom/.loom

# ── Agent sessions ────────────────────────────────────────────────────────
# loom runs no model requests of its own: every session is backed by a child
# `claude`, `codex` or `kiro-cli` process, which brings its own model choice
# and credentials. So there is no API key here — but the CLIs you use must be
# on PATH and already logged in:
#
#   claude    — logged in, or CLAUDE_CODE_USE_BEDROCK=1 plus AWS credentials
#   codex     — `codex login`
#   kiro-cli  — `kiro-cli login`, or an API key (docs/deploy.md)
#
# loom starts one shared `codex app-server` at boot, and one `claude` or
# `kiro-cli` process per active session (released after
# LOOM_IDLE_RELEASE_MINUTES idle, below).

# Optional: pin a specific binary (absolute path, or a wrapper script).
# LOOM_CLAUDE_CLI=claude
# LOOM_CODEX_CLI=codex
# LOOM_KIRO_CLI=kiro-cli

# Working directory for new sessions. Defaults to the user's home directory.
# Sessions have no project root of their own — which project is being worked on
# is a fact in the conversation, and the model composes absolute paths from it.
# LOOM_WORKSPACE=/srv/work

# The model a new Kiro session starts on (an id from `kiro-cli chat --list-models`).
# Unset, Kiro's own `auto`. The composer's menu still switches it per session.
# LOOM_KIRO_MODEL=claude-opus-5.5

# Minutes a session keeps its Claude Code or Kiro process after its last turn.
# Past it the next turn pays a cold start of about 4 s.
# LOOM_IDLE_RELEASE_MINUTES=5

# Where apps run: an origin of their own, never Loom's. Point a second tunnel
# host at LOOM_APPS_PORT. Unset, apps are at http://localhost:5000 only.
# LOOM_APPS_URL=https://loom-apps.example.com
# LOOM_APPS_PORT=5000

# ── Your own iPhone app: notifications and sign-in ────────────────────────
# Only if you build the iOS app under your own Apple developer team: its APNs
# key (the .p8 from the developer account, downloadable once; a file, mode
# 0600, kept outside the repo), the key's id and the team's. Unset, devices
# get Web Push only.
# LOOM_APNS_KEY_FILE=/home/loom/.config/loom/apns.p8
# LOOM_APNS_KEY_ID=ABCDE12345
# LOOM_APNS_TEAM_ID=FGHIJ67890
# The app's id, <team id>.<bundle id>, so its own sign-in screen can use this
# Loom's passkeys (served in /.well-known/apple-app-site-association).
# LOOM_IOS_APP_ID=FGHIJ67890.com.example.loom
