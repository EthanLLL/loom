# Copy to .env and fill in. Loaded automatically by the release via
# rel/env.sh.eex on every start. Plain KEY=value lines (no `export` needed).

# Required. Generate with: mix phx.gen.secret
# Keep this stable — changing it invalidates all login tokens.
SECRET_KEY_BASE=

# Required. The single login password.
LOOM_PASSWORD=

# Public host (your CloudFront domain). Used for generated URLs only.
PHX_HOST=localhost

# Must be true for the release to actually serve HTTP.
PHX_SERVER=true

# Optional: bind port (defaults to 4000).
# PORT=4000

# Optional: where loom keeps its own state — session headers, transcripts, and
# the files you attach to a conversation. Defaults to ~/.loom. Deliberately
# outside the release, which a deploy replaces.
# LOOM_HOME=/home/loom/.loom

# ── Agent sessions ────────────────────────────────────────────────────────
# loom runs no model requests of its own: every session is backed by a child
# `claude` or `codex` process, which brings its own model choice and
# credentials. So there is no API key here — but both CLIs must be on PATH and
# already logged in:
#
#   claude  — logged in, or CLAUDE_CODE_USE_BEDROCK=1 plus AWS credentials
#   codex   — `codex login`
#
# loom starts one shared `codex app-server` at boot and one `claude` process
# per active session (released after 15 idle minutes).

# Optional: pin a specific binary (absolute path, or a wrapper script).
# LOOM_CLAUDE_CLI=claude
# LOOM_CODEX_CLI=codex

# Working directory for new sessions. Defaults to the user's home directory.
# Sessions have no project root of their own — which project is being worked on
# is a fact in the conversation, and the model composes absolute paths from it.
# LOOM_WORKSPACE=/srv/work
