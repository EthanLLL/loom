#!/bin/sh
# Loaded automatically by the release on every start/daemon/remote/etc.
# Sources a .env file so runtime config (SECRET_KEY_BASE, LOOM_PASSWORD,
# PHX_HOST, PHX_SERVER, ...) doesn't have to be exported by hand.
#
# Lookup order:
#   1. $LOOM_ENV_FILE if set
#   2. .env next to the release root (RELEASE_ROOT)
#   3. .env in the current working directory
#
# .env format: plain KEY=value lines (no `export` needed; we auto-export).

_loom_load_env() {
  _env_file=""

  if [ -n "${LOOM_ENV_FILE:-}" ] && [ -f "${LOOM_ENV_FILE}" ]; then
    _env_file="${LOOM_ENV_FILE}"
  elif [ -n "${RELEASE_ROOT:-}" ] && [ -f "${RELEASE_ROOT}/.env" ]; then
    _env_file="${RELEASE_ROOT}/.env"
  elif [ -f "./.env" ]; then
    _env_file="./.env"
  fi

  if [ -n "${_env_file}" ]; then
    set -a
    # shellcheck disable=SC1090
    . "${_env_file}"
    set +a
  fi
}

_loom_load_env
