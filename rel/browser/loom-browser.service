# The persistent browser (see loom-browser.sh). Install:
#   sudo apt-get install -y xvfb x11vnc x11-utils
#   sudo cp rel/browser/loom-browser.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now loom-browser
[Unit]
Description=loom browser (Chromium on a virtual display)
After=network-online.target

[Service]
Type=exec
User=ubuntu
Environment=HOME=/home/ubuntu
Environment=LANG=C.UTF-8
ExecStart=/home/ubuntu/loom/rel/browser/loom-browser.sh
Restart=always
RestartSec=3
# A host without swap: past this, Chromium loses a tab, not loom or an agent its
# process. High reclaims first; Max is the wall.
MemoryHigh=3500M
MemoryMax=4500M

[Install]
WantedBy=multi-user.target
